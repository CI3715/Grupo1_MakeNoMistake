{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cuentas Claras",
  "version": "0.1.0",
  "identifier": "com.cuentasclaras.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cuentas Claras",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
  "security": {
    "csp": {
      "default-src": "'self'",
      "script-src": "'self'",
      "style-src": "'self' 'unsafe-inline'",
      "img-src": "'self' data:",
      "font-src": "'self' data:",
      "connect-src": "ipc: http://ipc.localhost"
     },
     "devCsp": {
       "default-src": "'self'",
       "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
       "style-src": "'self' 'unsafe-inline'",
       "img-src": "'self' data: blob:",
       "font-src": "'self' data:",
       "connect-src": "ipc: http://ipc.localhost ws://localhost:3000 http://localhost:3000"
     }
   }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
