# Configuración del servidor de Cuentas Claras.
# Copia este archivo como `.env` y ajusta los valores. `.env` no se sube a Git.

# Conexión a PostgreSQL. Es obligatoria: sin ella el servidor no arranca.
#
# Elige UNA de las tres opciones y deja las otras comentadas.

# --- Opción A: Docker Compose (recomendada para desarrollo y pruebas) --------
# Desde servidor/:
#   docker compose up -d
#
# Levanta PostgreSQL 17 en 127.0.0.1:55432 con las bases cuentas_claras y
# cuentas_claras_pruebas. El usuario y la clave son los de
# CUENTAS_CLARAS_DB_USUARIO y CUENTAS_CLARAS_DB_CLAVE, más abajo.
CUENTAS_CLARAS_DB_URL=postgresql://usuario:clave@127.0.0.1:55432/cuentas_claras

# --- Opción B: Supabase (trabajo compartido y demostración) ------------------
# Usa la cadena del Session pooler: IPv4, puerto 5432 y usuario
# postgres.<referencia>. No uses la conexión directa (solo IPv6) ni el modo
# transacción (no admite los prepared statements que psycopg necesita).
#
# Añade sslmode=require y codifica la clave si tiene caracteres especiales.
# Esta cadena va solo en .env y se comparte por un canal privado, nunca por el
# repositorio ni por el grupo de chat.
#
# Las pruebas nunca apuntan a Supabase: hacen TRUNCATE sobre usuarios.
# CUENTAS_CLARAS_DB_URL=postgresql://postgres.<referencia>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Opción C: PostgreSQL propio ---------------------------------------------
# Con el clúster local incluido (sin Docker ni sudo):
#   bash scripts/base_datos_local.sh iniciar
# CUENTAS_CLARAS_DB_URL=postgresql://usuario:clave@127.0.0.1:55432/cuentas_claras
#
# Con un PostgreSQL ya instalado en el puerto habitual:
# CUENTAS_CLARAS_DB_URL=postgresql://usuario:clave@127.0.0.1:5432/cuentas_claras

# Credenciales de desarrollo. Las usa el script del clúster local para crear el
# rol y las bases, y Docker Compose para el usuario y la clave del contenedor.
# El servidor no las lee: él usa CUENTAS_CLARAS_DB_URL. Deben coincidir con el
# usuario y la clave de esa URL.
#
# El usuario solo puede tener letras, números y guion bajo; la clave admite
# otros caracteres (en la URL, codifícalos). En Supabase no se usan.
CUENTAS_CLARAS_DB_USUARIO=usuario
CUENTAS_CLARAS_DB_CLAVE=clave

# Base que usan las pruebas de integración del repositorio (opcional).
# Si no se define, esas pruebas se omiten y `uv run pytest` sigue funcionando.
# Nunca apuntes esta variable a Supabase.
CUENTAS_CLARAS_DB_URL_PRUEBAS=postgresql://usuario:clave@127.0.0.1:55432/cuentas_claras_pruebas

# Secreto para firmar los JWT. Obligatorio, mínimo 32 caracteres.
# Genera uno distinto para cada entorno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CUENTAS_CLARAS_SECRETO_JWT=cambia-esto

# Vigencia del token en minutos. Si se omite, vale 60.
CUENTAS_CLARAS_MINUTOS_TOKEN=60
