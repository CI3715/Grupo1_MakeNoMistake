# Configuración del servidor de Cuentas Claras.
# Copia este archivo como `.env` y ajusta los valores. `.env` no se sube a Git.

# Conexión a PostgreSQL. Es obligatoria: sin ella el servidor no arranca.
#
# Opción A: clúster local incluido para desarrollo (sin Docker ni sudo).
#   bash scripts/base_datos_local.sh iniciar
CUENTAS_CLARAS_DB_URL=postgresql://cuentas_claras:cuentas_claras@127.0.0.1:55432/cuentas_claras

# Opción B: tu propio PostgreSQL en el puerto habitual.
# CUENTAS_CLARAS_DB_URL=postgresql://cuentas_claras:cuentas_claras@127.0.0.1:5432/cuentas_claras

# Base que usan las pruebas de integración del repositorio (opcional).
# Si no se define, esas pruebas se omiten y `uv run pytest` sigue funcionando.
CUENTAS_CLARAS_DB_URL_PRUEBAS=postgresql://cuentas_claras:cuentas_claras@127.0.0.1:55432/cuentas_claras_pruebas

# Secreto para firmar los JWT. Obligatorio, mínimo 32 caracteres.
# Genera uno distinto para cada entorno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CUENTAS_CLARAS_SECRETO_JWT=cambia-esto

# Vigencia del token en minutos. Si se omite, vale 60.
CUENTAS_CLARAS_MINUTOS_TOKEN=60
